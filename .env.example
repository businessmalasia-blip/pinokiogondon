# ===== Обязательные ключи =====
HELIUS_API_KEY=your_helius_api_key
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Программа Pump.fun =====
PUMP_PROGRAM=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Индексы аккаунтов в инструкции buy (mint и bonding curve)
BUY_MINT_INDEX=2
BUY_BONDING_CURVE_INDEX=3

# ===== Market cap =====
# Порог запуска анализа, $
MC_ANALYZE_MIN=8000
# Потолок запуска анализа, $ (токены выше не анализируются; 0 = без потолка)
MC_ANALYZE_MAX=13000
# Диапазон для отправки алерта, $
MIN_CAP_ALERT=9000
MAX_CAP_ALERT=12000
# Жёсткий диапазон в момент отправки (вне него алерт не отправляется), $
GUARD_MIN_CAP=9000
GUARD_MAX_CAP=13000
# Интервал опроса bonding curve, сек
MC_POLL_INTERVAL=2
# Максимальное время ожидания входа капы в диапазон, сек
MC_WAIT_TIMEOUT=1200
# Прервать ожидание, если капа упала ниже этого уровня, $ (0 = не прерывать)
MC_WAIT_ABORT_BELOW=6000
# Сколько секунд ждать камбэк, пока капа ниже порога слива
MC_COMEBACK_WAIT=300
# Если getAccountInfo не отдаёт свежую капу дольше стольки секунд — не слать алерт
MC_STALE_TIMEOUT=30

# ===== Предварительные проверки (до фильтров) =====
# Пропускать токены старше стольки часов
MAX_TOKEN_AGE_HOURS=2
# Пропускать токены, у которых последняя сделка была раньше стольки секунд назад
MAX_INACTIVE_SECONDS=120
# Минимум транзакций за последние 2 минуты (проверка плотности торговли)
MIN_BUY_COUNT_LAST_2MIN=2

# ===== WebSocket =====
# URL для logsSubscribe. Helius (wss://mainnet.helius-rpc.com) тарифицирует
# каждое WS-событие как LaserStream-кредит — тысячи в минуту сжигают 1M/мес за сутки.
# По умолчанию используется публичный Solana RPC — бесплатно, без streaming-кредитов.
# Если нужна надёжность — укажи другого провайдера (QuickNode, Alchemy и т.п.).
WS_RPC_URL=wss://api.mainnet-beta.solana.com

# ===== Цена SOL =====
SOL_PRICE_INTERVAL=2

# ===== Rate limiting Helius =====
HELIUS_RATE_LIMIT=0.3

# ===== Фильтр 1: концентрация =====
# Доля, выше которой аккаунт считается bonding curve и исключается, %
BONDING_CURVE_EXCLUDE_PERCENT=50
# Максимальная доля одного холдера, %
MAX_SINGLE_HOLDER_PERCENT=100.0
# Максимальная суммарная доля топ-10, %
MAX_TOP10_HOLDERS_PERCENT=100.0

# ===== Фильтр 2: HUMAN =====
HUMAN_MIN_PERCENT=60
UNKNOWN_MAX_PERCENT=15
# Ужесточённые пороги для Unknown-девов (защита от рагпулов)
HUMAN_MIN_PERCENT_UNKNOWN=55
UNKNOWN_MAX_PERCENT_UNKNOWN=20
HUMAN_CACHE_TTL=3600
UNKNOWN_CACHE_TTL=3600
# Проверять только топ-N холдеров по балансу
HUMAN_CHECK_TOP=30
# Игнорировать адреса с долей меньше этой, %
HUMAN_MIN_HOLDER_SHARE=0.5
# Минимум адресов в выборке
HUMAN_MIN_CANDIDATES=10

# ===== Бандлы =====
# Бандл = покупки в слоте создания токена + столько следующих слотов
BUNDLE_SLOT_WINDOW=2
# Жёсткий порог: токены с долей бандлов выше этого значения отсеиваются, %
MAX_BUNDLE_PERCENT=20

# ===== Скоринг =====
# Минимальный итоговый скор для отправки алерта (0–10)
MIN_SCORE=8.0
# Веса метрик (в сумме 1.0)
SCORE_WEIGHT_HUMAN=0.30
SCORE_WEIGHT_MSR=0.25
SCORE_WEIGHT_CONCENTRATION=0.25
SCORE_WEIGHT_BUNDLE=0.20

# ===== Фильтр 3: дев =====
MSR_MIN_PERCENT=80
DEV_MIN_TOKENS=3
DEV_HISTORY_DAYS=30
DEV_TX_LIMIT=50
DEV_TOKENS_CHECK_MAX=20
# Минимальный суточный объём для "выжившего" токена, $
SURVIVOR_MIN_VOLUME_USD=1000

# ===== Стабильный рост (Anti-Volatility) =====
# Если капа выросла больше этого % за STABILITY_CHECK_SECONDS — не слать алерт
MAX_PRICE_INCREASE_PERCENT=30
# Окно проверки стабильности роста, сек
STABILITY_CHECK_SECONDS=60
# Условие B: мгновенный разворот — падение от пика на этот % за < STABILITY_CHECK_SECONDS
SHARP_REVERSAL_DROP_PERCENT=10

# ===== Торговые сессии (Москва) =====
TIMEZONE=Europe/Moscow
# Европейская сессия (часы МСК, включительно от START, до END не включая)
EU_SESSION_START=10
EU_SESSION_END=16
# Американская сессия (часы МСК)
US_SESSION_START=16
US_SESSION_END=23

# ===== Новые фильтры =====
# Минимальный рост капы за STABILITY_CHECK_SECONDS, % (0 = отключить)
MIN_TREND_PERCENT=0.5
TREND_WAIT_TIMEOUT=300
TREND_RECHECK_INTERVAL=60
# Минимальный USD-объём покупок за последние 5 мин (из WebSocket-событий)
MIN_VOLUME_USD_5MIN=150
# Минимальное кол-во уникальных покупателей за последние 5 мин
MIN_UNIQUE_BUYERS_5MIN=2
# Требовать, чтобы дев купил токен в первые DEV_EARLY_BUY_WINDOW сек после создания
DEV_EARLY_BUY_REQUIRED=true
DEV_EARLY_BUY_WINDOW=300

# ===== Прочее =====
SEEN_MINT_TTL=3600
MAX_CONCURRENT_ANALYSES=3
CANDIDATE_QUEUE_SIZE=100
DAS_MIN_ACCOUNTS=15
DAS_RETRY_DELAY=3
DAS_RETRIES=1
ANALYSIS_RETRY_TTL=180
ALERT_DEDUP_TTL=86400
LOG_LEVEL=INFO
