# ===== Обязательные ключи =====
HELIUS_API_KEY=your_helius_api_key
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Программа Pump.fun =====
PUMP_PROGRAM=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Индексы аккаунтов в инструкции buy (mint и bonding curve)
BUY_MINT_INDEX=2
BUY_BONDING_CURVE_INDEX=3

# ===== Market cap =====
# Порог запуска анализа, $
MC_ANALYZE_MIN=8000
# Потолок запуска анализа, $ (токены выше не анализируются — алерт всё равно
# не отправится из-за guard-диапазона; 0 = без потолка)
MC_ANALYZE_MAX=13000
# Диапазон для отправки алерта, $
ALERT_MC_MIN=10000
ALERT_MC_MAX=12000
# Жёсткий диапазон в момент отправки (вне него алерт не отправляется), $
SEND_GUARD_MC_MIN=9000
SEND_GUARD_MC_MAX=13000
# Интервал опроса bonding curve, сек
MC_POLL_INTERVAL=2
# Максимальное время ожидания входа капы в диапазон, сек
MC_WAIT_TIMEOUT=1200
# Прервать ожидание, если капа упала ниже этого уровня, $ (0 = не прерывать)
MC_WAIT_ABORT_BELOW=6000

# ===== Цена SOL =====
# Интервал обновления цены SOL из Jupiter, сек
SOL_PRICE_INTERVAL=2

# ===== Rate limiting Helius =====
HELIUS_RATE_LIMIT=0.25

# ===== Фильтр 1: концентрация =====
# Доля, выше которой аккаунт считается bonding curve и исключается, %
BONDING_CURVE_EXCLUDE_PERCENT=50
# Максимальная доля одного холдера, %
HOLDER_MAX_PERCENT=2.5
# Максимальная суммарная доля топ-10, %
TOP10_MAX_PERCENT=15

# ===== Фильтр 2: HUMAN =====
HUMAN_MIN_PERCENT=45
UNKNOWN_MAX_PERCENT=30
HUMAN_CACHE_TTL=3600
UNKNOWN_CACHE_TTL=3600
# Проверять только топ-N холдеров по балансу
HUMAN_CHECK_TOP=30
# Игнорировать адреса с долей меньше этой, %
HUMAN_MIN_HOLDER_SHARE=0.5
# Минимум адресов в выборке (добор следующими по размеру, если после отсечки мало)
HUMAN_MIN_CANDIDATES=10

# ===== Бандлы =====
# Бандл = покупки в слоте создания токена + столько следующих слотов
BUNDLE_SLOT_WINDOW=2

# ===== Скоринг =====
# Минимальный итоговый скор для отправки алерта (0-10)
MIN_SCORE=7.5
# Веса метрик (в сумме 1.0)
SCORE_WEIGHT_HUMAN=0.30
SCORE_WEIGHT_MSR=0.25
SCORE_WEIGHT_CONCENTRATION=0.25
SCORE_WEIGHT_BUNDLE=0.20
# Unknown-дев (нет истории) не штрафуется нулём за MSR: его вес
# распределяется на HUMAN/концентрацию/бандлы. false = старое поведение
# (Unknown = 0 баллов за MSR, потолок скора 7.5)
DEV_UNKNOWN_NEUTRAL=true

# ===== Фильтр 3: дев =====
MSR_MIN_PERCENT=70
DEV_MIN_TOKENS=3
DEV_HISTORY_DAYS=30
DEV_TX_LIMIT=50
DEV_TOKENS_CHECK_MAX=20
# Минимальный суточный объём для "выжившего" токена, $
SURVIVOR_MIN_VOLUME_USD=1000

# ===== Прочее =====
# TTL метки "токен уже обработан", сек
SEEN_MINT_TTL=3600
# Максимум одновременных анализов (число воркеров)
MAX_CONCURRENT_ANALYSES=3
# Размер очереди кандидатов на анализ (излишек сбрасывается)
CANDIDATE_QUEUE_SIZE=100
# Минимум токен-аккаунтов (getTokenLargestAccounts отдаёт до 20), чтобы верить данным
DAS_MIN_ACCOUNTS=15
# Пауза перед перечитыванием списка аккаунтов, сек, и число попыток
DAS_RETRY_DELAY=12
DAS_RETRIES=2
# Через сколько секунд повторить анализ токена, если данные ещё не
# проиндексированы или транзакция не получена
ANALYSIS_RETRY_TTL=180
LOG_LEVEL=INFO
